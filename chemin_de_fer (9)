// PROGRESS
// ════════════════════════════════════════════════════
function updateProg(){
  let w=0,d=0,v=0;
  pages.forEach(p=>{if(p.st==='wip')w++;else if(p.st==='done')d++;else if(p.st==='val')v++;});
  const n=pages.length;
  document.getElementById('c-wip').textContent=w;
  document.getElementById('c-done').textContent=d;
  document.getElementById('c-val').textContent=v;
  document.getElementById('pg-wip').style.width=(w/n*100)+'%';
  document.getElementById('pg-done').style.width=(d/n*100)+'%';
  document.getElementById('pg-val').style.width=(v/n*100)+'%';
}

// ════════════════════════════════════════════════════
// STATS
// ════════════════════════════════════════════════════
function renderStats(){
  // by pole/service
  const counts={};
  ALL_SVCS.forEach(s=>counts[s]=0);
  pages.forEach(p=>{(p.svcs||[]).forEach(s=>{if(counts[s]!==undefined)counts[s]++;});});
  const poleCounts={};
  Object.entries(POLES).forEach(([pole,svcs])=>{poleCounts[pole]=svcs.reduce((a,s)=>a+(counts[s]||0),0);});
  const maxPole=Math.max(...Object.values(poleCounts),1);

  const sg=document.getElementById('statsGrid');sg.innerHTML='';
  Object.entries(POLES).forEach(([pole,svcs])=>{
    const card=document.createElement('div');card.className='stat-card';
    const h=document.createElement('h3');h.textContent=pole;card.appendChild(h);
    svcs.forEach(s=>{
      const c=counts[s]||0;
      if(c===0 && svcs.length>1) return;
      const row=document.createElement('div');row.className='stat-row';
      const lbl=document.createElement('span');lbl.className='stat-svc';lbl.textContent=s;
      const bw=document.createElement('div');bw.className='stat-bar-wrap';
      const b=document.createElement('div');b.className='stat-bar';b.style.width=(c/Math.max(...svcs.map(x=>counts[x]||0),1)*100)+'%';
      bw.appendChild(b);
      const n=document.createElement('span');n.className='stat-num';n.textContent=c;
      row.appendChild(lbl);row.appendChild(bw);row.appendChild(n);card.appendChild(row);
    });
    const tot=document.createElement('div');tot.className='stat-total';
    tot.innerHTML=`Total pôle : <span class="stat-badge">${poleCounts[pole]}</span>`;
    card.appendChild(tot);sg.appendChild(card);
  });

  // by type
  const typeCounts={};
  TYPES.forEach(t=>typeCounts[t.id]=0);
  pages.forEach(p=>(p.ci||[]).forEach(ci=>{if(typeCounts[ci.t]!==undefined)typeCounts[ci.t]++;}));
  const maxType=Math.max(...Object.values(typeCounts),1);
  const tc=document.getElementById('typeChart');tc.innerHTML='';
  TYPES.forEach(t=>{
    const c=typeCounts[t.id]||0;
    const row=document.createElement('div');row.className='tc-row';
    const lbl=document.createElement('span');lbl.className='tc-lbl';lbl.textContent=t.lbl;
    const sg=document.createElement('span');sg.className='tc-signs';sg.textContent=t.signs?t.signs+'sc':'';
    const bw=document.createElement('div');bw.className='tc-bar-w';
    const b=document.createElement('div');b.className='tc-bar';b.style.width=(c/maxType*100)+'%';
    bw.appendChild(b);
    const n=document.createElement('span');n.className='tc-num';n.textContent=c;
    row.appendChild(lbl);row.appendChild(sg);row.appendChild(bw);row.appendChild(n);tc.appendChild(row);
  });
}

