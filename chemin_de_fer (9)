function openEdit(i){
  curIdx=i;const p=pages[i]||{};
  curSta=p.st||'todo';curPar=p.p||'B';
  curSvcs=[...(p.svcs||[])];
  curCi=(p.ci||[]).map(x=>({...x}));

  document.getElementById('mttl').textContent=i===0?'1ère de couverture':i===pages.length-1?'4ème de couverture':'Page '+(i+1);
  document.getElementById('e-rub').value=p.r||'';
  setSta(curSta);setPar(curPar);
  buildSvcTags();buildCiList();

  // protect covers from deletion
  document.getElementById('btn-del-page').style.display=(p.sp==='couv')?'none':'block';
  document.getElementById('editOverlay').classList.add('open');
}
function closeEdit(){document.getElementById('editOverlay').classList.remove('open');curIdx=null;}

function setSta(s){curSta=s;['t','w','d','v'].forEach((x,j)=>document.getElementById('sb-'+x).classList.toggle('on',['todo','wip','done','val'][j]===s));}
function setPar(p){curPar=p;document.getElementById('pb-a').classList.toggle('on',p==='A');document.getElementById('pb-b').classList.toggle('on',p==='B');}

// service tags in modal
function buildSvcTags(){
  populateSvcDropdown();
  const wrap=document.getElementById('svc-tags');wrap.innerHTML='';
  curSvcs.forEach(s=>{
    const t=document.createElement('span');t.className='svc-sel-tag';t.textContent=s;
    const d=document.createElement('button');d.textContent='×';
    d.onclick=()=>{curSvcs=curSvcs.filter(x=>x!==s);buildSvcTags();};
    t.appendChild(d);wrap.appendChild(t);
  });
}
function populateSvcDropdown(){
  const dd=document.getElementById('svc-dropdown');dd.innerHTML='<option value="">+ Ajouter un service…</option>';
  ALL_SVCS.filter(s=>!curSvcs.includes(s)).forEach(s=>{const o=document.createElement('option');o.value=s;o.textContent=s;dd.appendChild(o);});
}
function addSvcTag(v){if(!v||curSvcs.includes(v))return;curSvcs.push(v);buildSvcTags();}

// content items in modal
function buildCiList(){
  const list=document.getElementById('ci-list');list.innerHTML='';
  curCi.forEach((ci,j)=>{
    const item=document.createElement('div');item.className='ci-item';
    // type selector
    const head=document.createElement('div');head.className='ci-item-head';
    const tsel=document.createElement('select');tsel.className='ci-type-sel';
    TYPES.forEach(t=>{const o=document.createElement('option');o.value=t.id;o.textContent=t.lbl+(t.signs?' ('+t.signs+'sc)':'');o.selected=t.id===ci.t;tsel.appendChild(o);});
    tsel.onchange=()=>{ci.t=tsel.value;updateSignsHint(hint,ci.t);};
    const hint=document.createElement('span');hint.className='ci-signs-hint';
    updateSignsHint(hint,ci.t);
    head.appendChild(tsel);head.appendChild(hint);
    // text
    const txf=document.createElement('input');txf.className='ci-txt-i';txf.placeholder='Titre / sujet…';txf.value=ci.tx||'';txf.oninput=()=>ci.tx=txf.value;
    // service
    const srow=document.createElement('div');srow.className='ci-svc-row';
    const slbl=document.createElement('span');slbl.style.cssText='font-size:10.5px;color:var(--tx2);';slbl.textContent='Service :';
    const ssel=document.createElement('select');ssel.className='ci-svc-sel';
    const emptyO=document.createElement('option');emptyO.value='';emptyO.textContent='— choisir —';ssel.appendChild(emptyO);
    ALL_SVCS.forEach(s=>{const o=document.createElement('option');o.value=s;o.textContent=s;o.selected=s===ci.s;ssel.appendChild(o);});
    ssel.onchange=()=>ci.s=ssel.value;
    srow.appendChild(slbl);srow.appendChild(ssel);
    // delete
    const del=document.createElement('button');del.className='ci-del-btn';del.textContent='✕';
    del.onclick=()=>{curCi.splice(j,1);buildCiList();};
    item.appendChild(del);item.appendChild(head);item.appendChild(txf);item.appendChild(srow);
    list.appendChild(item);
  });
}
function updateSignsHint(el,typeId){
  const t=TYPES.find(x=>x.id===typeId);
  el.textContent=t&&t.signs?'≈ '+t.signs+' signes (avec espaces)':'';
}
function addCiItem(){curCi.push({t:'breve',tx:'',s:''});buildCiList();}

function saveEdit(){
  if(curIdx===null)return;
  const p=pages[curIdx];
  p.r=document.getElementById('e-rub').value;
  p.st=curSta;p.p=curPar;
  p.svcs=[...curSvcs];
  p.ci=curCi.map(x=>({...x}));
  saveData();closeEdit();renderAll();
}

function deleteCurPage(){
  if(curIdx===null)return;
  if(pages[curIdx].sp==='couv'){alert('Les couvertures ne peuvent pas être supprimées.');return;}
  if(!confirm('Supprimer la page '+(curIdx+1)+' ?')) return;
  pages.splice(curIdx,1);
  saveData();closeEdit();renderAll();
}
function deletePageAt(i){
  if(pages[i].sp==='couv') return;
  if(!confirm('Supprimer la page '+(i+1)+' ?')) return;
  pages.splice(i,1);saveData();renderAll();
}

// ════════════════════════════════════════════════════
// GÉRER PAGES MODAL
// ════════════════════════════════════════════════════
function openAddModal(){
  const n=pages.length;
  const sel=document.getElementById('addCount');
  sel.innerHTML=[4,8,12].map(x=>`<option value="${x}">+ ${x} pages (→ ${n+x} pages)</option>`).join('');
  buildDelPageList();
  document.getElementById('addOverlay').classList.add('open');
}
function closeAddModal(){document.getElementById('addOverlay').classList.remove('open');}

function buildDelPageList(){
  const list=document.getElementById('del-page-list');list.innerHTML='';
  pages.forEach((p,i)=>{
    if(p.sp==='couv') return;
    const btn=document.createElement('button');
    btn.style.cssText='font-size:11px;padding:4px 8px;border-radius:4px;border:1px solid var(--bdr);background:var(--sur2);cursor:pointer;';
    btn.textContent='P.'+(i+1)+(p.r?' – '+p.r.substring(0,14):'');
    btn.onclick=()=>{if(!confirm('Supprimer la page '+(i+1)+' ?')) return;pages.splice(i,1);saveData();renderAll();buildDelPageList();openAddModal();};
    list.appendChild(btn);
  });
}

function confirmAdd(){
  const n=parseInt(document.getElementById('addCount').value);
  const pos=document.getElementById('addPos').value;
  const blank=()=>({r:'',ci:[],svcs:[],p:'B',st:'todo',on:false,onc:''});
  const nb=Array.from({length:n},blank);
  if(pos==='end') pages.splice(pages.length-1,0,...nb);
  else pages.splice(Math.floor(pages.length/2),0,...nb);
  saveData();renderAll();buildDelPageList();
  const sel=document.getElementById('addCount');
  sel.innerHTML=[4,8,12].map(x=>`<option value="${x}">+ ${x} pages (→ ${pages.length+x} pages)</option>`).join('');
}

// ════════════════════════════════════════════════════
// RÉTROPLANNING
// ════════════════════════════════════════════════════
function buildRetro(){
  const bar=document.getElementById('rbar');
  const ph=document.getElementById('rphases');
  const tot=PHASES.reduce((a,p)=>a+p.w,0);
  PHASES.forEach(p=>{
    const seg=document.createElement('div');seg.className='rseg';
    seg.style.cssText=`background:${p.col};width:${p.w/tot*100}%`;
    seg.innerHTML=`<span class="rseg-lbl">${p.short}</span>`;
    seg.addEventListener('mouseenter',e=>showTip(e,p));
    seg.addEventListener('mousemove',moveTip);
    seg.addEventListener('mouseleave',hideTip);
    seg.addEventListener('click',()=>{openRetro();setTimeout(()=>document.getElementById('rp-'+p.id)?.scrollIntoView({behavior:'smooth',block:'nearest'}),100);});
    bar.appendChild(seg);
    const card=document.createElement('div');card.className='rphase';card.id='rp-'+p.id;
    card.style.background=p.bg;
    card.innerHTML=`<div class="rphase-dot" style="background:${p.col}"></div><div><div class="rphase-ttl" style="color:${p.col}">${p.weeks} — ${p.lbl}</div><div class="rphase-items">${p.items.map(x=>'• '+x).join('<br>')}</div></div>`;
    ph.appendChild(card);
  });
}

function toggleRetro(){const b=document.getElementById('rbody');const open=b.classList.toggle('open');document.getElementById('rchev').textContent=open?'▲ Replier':'▼ Déplier';}
function openRetro(){const b=document.getElementById('rbody');if(!b.classList.contains('open')){b.classList.add('open');document.getElementById('rchev').textContent='▲ Replier';}}

function showTip(e,p){const t=document.getElementById('rtip');t.innerHTML=`<h4 style="color:${p.col}">${p.weeks} — ${p.lbl}</h4><ul>${p.items.map(x=>`<li>${x}</li>`).join('')}</ul>`;t.classList.add('open');moveTip(e);}
function moveTip(e){const t=document.getElementById('rtip');let x=e.clientX+14,y=e.clientY+12;if(x+285>window.innerWidth)x=e.clientX-290;t.style.left=x+'px';t.style.top=y+'px';}
function hideTip(){document.getElementById('rtip').classList.remove('open');}

function updateRetroCursor(){
  const dateStr=document.getElementById('retroDate').value;
  const cursor=document.getElementById('retroCursor');
  if(!dateStr){cursor.style.display='none';return;}

  const distrib=new Date(dateStr);
  const today=new Date();today.setHours(0,0,0,0);

  // diff in weeks (negative = before distribution)
  const diffMs=today-distrib;
  const diffWeeks=diffMs/(7*24*3600*1000);

  // total timeline: S-12 to S+1
  const tStart=-12, tEnd=1, tRange=tEnd-tStart;
  const pos=(diffWeeks-tStart)/tRange;

  // readable
  const opts={day:'numeric',month:'long',year:'numeric'};
  document.getElementById('retroDateReadable').textContent='Distribution : '+distrib.toLocaleDateString('fr-FR',opts);

  if(pos<0||pos>1){cursor.style.display='none';return;}
  cursor.style.display='block';
  cursor.style.left=(pos*100)+'%';

  // label
  const wLabel=Math.round(diffWeeks);
  cursor.setAttribute('data-label',wLabel===0?'Diffusion':wLabel>0?'S+'+wLabel:'S'+wLabel);

  saveData();
}

// ════════════════════════════════════════════════════
// INFO POPUP
// ════════════════════════════════════════════════════
function showInfo(e){
  e.stopPropagation();
  const pop=document.getElementById('ipop');
  const rect=e.target.getBoundingClientRect();
  pop.style.left=Math.min(rect.left,window.innerWidth-360)+'px';
  pop.style.top=(rect.bottom+5)+'px';
  pop.classList.toggle('open');
}
document.addEventListener('click',e=>{if(!e.target.closest('.ib')&&!e.target.closest('.ipop'))document.getElementById('ipop').classList.remove('open');});

// ════════════════════════════════════════════════════
// CLICK OUTSIDE MODALS
// ════════════════════════════════════════════════════
['editOverlay','addOverlay'].forEach(id=>{
  document.getElementById(id).addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});
});

// ════════════════════════════════════════════════════
// RENDER ALL
// ════════════════════════════════════════════════════
function renderAll(){
  renderGrid();updateProg();
  if(document.getElementById('view-table').classList.contains('active'))renderTable();
  if(document.getElementById('view-stats').classList.contains('active'))renderStats();
}

// ════════════════════════════════════════════════════
// INIT
// ════════════════════════════════════════════════════
(async()=>{
  await load();
  buildRetro();
  updateRetroCursor();
  renderAll();
})();
</script>
