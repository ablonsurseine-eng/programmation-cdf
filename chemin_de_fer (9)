function switchView(v){
  document.querySelectorAll('.view').forEach(e=>e.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(e=>e.classList.remove('active'));
  document.getElementById('view-'+v).classList.add('active');
  const i=['grid','table','stats'].indexOf(v);
  document.querySelectorAll('.tab')[i].classList.add('active');
  if(v==='table') renderTable();
  if(v==='stats') renderStats();
}

// ════════════════════════════════════════════════════
// GRID
// ════════════════════════════════════════════════════
function renderGrid(){
  const g=document.getElementById('grid'); g.innerHTML='';
  const n=pages.length, rs=10;
  for(let r=0;r*rs<n;r++){
    const w=document.createElement('div');
    const l=document.createElement('div');l.className='rlbl';
    l.textContent=`Pages ${r*rs+1}–${Math.min((r+1)*rs,n)}`;
    w.appendChild(l);
    const row=document.createElement('div');row.className='prow';
    for(let c=0;c<rs&&r*rs+c<n;c++) row.appendChild(makeCard(r*rs+c));
    w.appendChild(row);g.appendChild(w);
  }
  document.getElementById('pageChip').textContent=pages.length+' pages';
  document.getElementById('c-tot').textContent=pages.length;
}

function pgLabel(i){return i===0?'1ère couv.':i===pages.length-1?'4ème couv.':'P.'+(i+1);}

function makeCard(i){
  const p=pages[i];
  const d=document.createElement('div');
  d.className='card s-'+(p.st||'todo')+(p.sp==='couv'?' couv':p.sp?' sp':'');
  d.onclick=()=>openEdit(i);

  const del=document.createElement('button');
  del.className='card-del';del.title='Supprimer cette page';del.textContent='✕';
  del.onclick=e=>{e.stopPropagation();deletePageAt(i);};
  if(p.sp==='couv') del.style.display='none';
  d.appendChild(del);

  const num=document.createElement('div');num.className='cn';num.textContent=pgLabel(i);d.appendChild(num);
  if(p.r){const rb=document.createElement('div');rb.className='cr';rb.textContent=p.r;d.appendChild(rb);}

  const cc=document.createElement('div');cc.className='cc';
  (p.ci||[]).slice(0,3).forEach(ci=>{
    const row=document.createElement('div');row.className='citem';
    const tp=TYPES.find(t=>t.id===ci.t);
    const tb=document.createElement('span');tb.className='ctype';tb.textContent=tp?tp.lbl.split(' ').slice(-1)[0]:ci.t;
    const tx=document.createElement('span');tx.className='ctxt';tx.textContent=ci.tx||'';
    row.appendChild(tb);row.appendChild(tx);cc.appendChild(row);
  });
  if((p.ci||[]).length>3){const more=document.createElement('div');more.style.cssText='font-size:8px;color:var(--tx3);margin-top:2px;';more.textContent='+'+(p.ci.length-3)+' autre(s)';cc.appendChild(more);}
  d.appendChild(cc);

  const f=document.createElement('div');f.className='cfoot';
  const svclbl=(p.svcs||[]).slice(0,2).join(', ')+(p.svcs&&p.svcs.length>2?' +…':'');
  if(svclbl){const s=document.createElement('div');s.className='csvc';s.textContent=svclbl;f.appendChild(s);}
  if(p.p){const pa=document.createElement('div');pa.className='ppill p'+(p.p||'b').toLowerCase();pa.textContent=p.p;f.appendChild(pa);}
  d.appendChild(f);return d;
}

