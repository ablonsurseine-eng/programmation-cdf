<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Chemin de fer — L'Ablonais</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
/* ── RESET & VARS ── */
:root{
  --bg:#F5F3EE;--sur:#FFF;--sur2:#EEECE6;--bdr:#D8D4C8;
  --tx:#1A1916;--tx2:#6B6860;--tx3:#9B9890;
  --ac:#1A3A5C;--ac2:#2D6A9F;
  --todo:#F5F3EE;--todo-t:#6B6860;
  --wip:#FFF0D4;--wip-t:#8A5A00;--wip-b:#F0C060;
  --done:#D4EDD8;--done-t:#1A6B28;--done-b:#7DC88A;
  --val:#D4E4F5;--val-t:#0D3A6B;--val-b:#6AAAD8;
  --r:6px;--r2:10px;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;font-size:14px;}
button{font-family:'DM Sans',sans-serif;cursor:pointer;}
input,select,textarea{font-family:'DM Sans',sans-serif;}

/* ── HEADER ── */
header{background:var(--ac);color:#fff;padding:11px 24px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;}
.logo{font-family:'DM Serif Display',serif;font-size:20px;white-space:nowrap;}
.logo span{opacity:.5;font-size:11px;font-family:'DM Sans',sans-serif;font-weight:400;margin-left:7px;}
.h-meta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.chip{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.22);border-radius:20px;padding:3px 11px;font-size:11.5px;font-weight:500;display:flex;align-items:center;gap:4px;}
.chip input,.chip select{background:transparent;border:none;color:#fff;font-family:inherit;font-size:11.5px;font-weight:500;outline:none;}
.chip input.num{width:26px;}
.chip input.yr{width:38px;}
.chip input.parution{width:200px;}
.h-actions{display:flex;gap:6px;align-items:center;}
.btn-save-manual{background:#fff;color:var(--ac);border:none;border-radius:var(--r);padding:6px 13px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:5px;}
.btn-save-manual:hover{background:#e8f0fa;}
.save-indicator{font-size:11px;opacity:.55;white-space:nowrap;}

/* ── COLLAB BANNER ── */
.collab-banner{background:#1A5C3A;color:#fff;padding:7px 24px;font-size:12px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.collab-banner a{color:#7DDBA8;text-decoration:underline;cursor:pointer;}
.collab-mode-btn{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:var(--r);padding:3px 10px;font-size:11px;color:#fff;cursor:pointer;}
.collab-mode-btn:hover{background:rgba(255,255,255,.25);}

/* ── TABS ── */
.tabs{background:var(--sur);border-bottom:2px solid var(--bdr);padding:0 24px;display:flex;gap:0;overflow-x:auto;}
.tab{padding:10px 16px;font-size:13px;font-weight:500;color:var(--tx2);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s;white-space:nowrap;}
.tab:hover{color:var(--tx);}
.tab.active{color:var(--ac);border-bottom-color:var(--ac);}

/* ── RETRO ── */
.retro-wrap{background:var(--sur);border-bottom:1px solid var(--bdr);padding:10px 24px;}
.retro-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;cursor:pointer;user-select:none;}
.retro-ttl{font-size:11.5px;font-weight:600;color:var(--tx2);text-transform:uppercase;letter-spacing:.6px;}
.retro-sub{font-size:11px;color:var(--tx3);margin-left:8px;font-weight:400;text-transform:none;letter-spacing:0;}
.retro-chev{font-size:11px;color:var(--tx3);}
.retro-date-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;}
.retro-date-lbl{font-size:11px;color:var(--tx2);}
.retro-date-input{font-size:12px;border:1px solid var(--bdr);border-radius:var(--r);padding:3px 8px;color:var(--tx);background:var(--bg);outline:none;}
.retro-date-input:focus{border-color:var(--ac2);}
.retro-bar-wrap{position:relative;}
.retro-bar{display:flex;height:26px;gap:2px;border-radius:5px;overflow:hidden;}
.rseg{display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#fff;cursor:pointer;transition:filter .15s;flex-shrink:0;position:relative;}
.rseg:hover{filter:brightness(1.12);}
.rseg-lbl{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 5px;pointer-events:none;}
/* cursor on bar */
.retro-cursor{position:absolute;top:0;bottom:0;width:2px;background:#E8593C;z-index:10;pointer-events:none;transition:left .3s;}
.retro-cursor::before{content:'▼';position:absolute;top:-14px;left:50%;transform:translateX(-50%);font-size:10px;color:#E8593C;white-space:nowrap;}
.retro-cursor::after{content:attr(data-label);position:absolute;bottom:-18px;left:50%;transform:translateX(-50%);font-size:9px;color:#E8593C;white-space:nowrap;font-weight:600;}
.retro-body{display:none;margin-top:10px;}
.retro-body.open{display:block;}
.retro-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:5px;}
.rphase{border-radius:var(--r);padding:8px 11px;display:flex;gap:8px;}
.rphase-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:3px;}
.rphase-ttl{font-size:11.5px;font-weight:600;margin-bottom:3px;}
.rphase-items{font-size:11px;color:var(--tx2);line-height:1.6;}
/* retro tooltip */
.rtip{display:none;position:fixed;z-index:300;background:var(--sur);border:1px solid var(--bdr);border-radius:8px;padding:11px 13px;max-width:280px;box-shadow:0 8px 28px rgba(0,0,0,.18);font-size:11px;line-height:1.6;color:var(--tx);pointer-events:none;}
.rtip.open{display:block;}
.rtip h4{font-size:11.5px;font-weight:700;margin-bottom:4px;}
.rtip ul{padding-left:13px;color:var(--tx2);}

/* ── PROGRESS ── */
.prog-wrap{background:var(--sur);border-bottom:1px solid var(--bdr);padding:8px 24px;display:flex;align-items:center;gap:10px;}
.prog-lbl{font-size:11px;font-weight:600;color:var(--tx2);text-transform:uppercase;letter-spacing:.6px;white-space:nowrap;}
.prog-track{flex:1;height:6px;background:var(--sur2);border-radius:3px;overflow:hidden;display:flex;gap:2px;}
.pseg{height:100%;border-radius:2px;transition:width .3s;}
.pseg.wip{background:var(--wip-b);}
.pseg.done{background:var(--done-b);}
.pseg.val{background:var(--val-b);}
.pstats{display:flex;gap:12px;}
.pstat{font-size:11px;color:var(--tx2);}
.pstat strong{color:var(--tx);font-weight:600;}

/* ── TOOLBAR ── */
.toolbar{background:var(--sur);border-bottom:1px solid var(--bdr);padding:7px 24px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.tlbl{font-size:11px;font-weight:600;color:var(--tx2);text-transform:uppercase;letter-spacing:.6px;}
.legend{display:flex;gap:7px;flex-wrap:wrap;}
.li{display:flex;align-items:center;gap:4px;font-size:12px;color:var(--tx2);}
.ld{width:9px;height:9px;border-radius:3px;flex-shrink:0;}
.ld-todo{background:var(--todo);border:1px solid var(--bdr);}
.ld-wip{background:var(--wip);border:1px solid var(--wip-b);}
.ld-done{background:var(--done);border:1px solid var(--done-b);}
.ld-val{background:var(--val);border:1px solid var(--val-b);}
.tsep{width:1px;height:18px;background:var(--bdr);margin:0 3px;}
.ppill{font-size:8px;font-weight:700;border-radius:3px;padding:1px 5px;}
.pa{background:#E8F0FA;color:#1A3A5C;}
.pb{background:#F0EAF8;color:#4A1A7A;}
.btn{background:var(--ac);color:#fff;border:none;border-radius:var(--r);padding:5px 11px;font-size:12px;font-weight:500;transition:opacity .15s;white-space:nowrap;}
.btn:hover{opacity:.85;}
.btn-o{background:none;border:1px solid var(--bdr);border-radius:var(--r);padding:5px 11px;font-size:12px;color:var(--tx2);}
.btn-o:hover{border-color:var(--ac2);color:var(--ac);}
.btn-del{background:none;border:1px solid #F0C0C0;border-radius:var(--r);padding:5px 11px;font-size:12px;color:#B02020;}
.btn-del:hover{background:#FDE8E8;}

/* ── VIEWS ── */
.view{display:none;padding:20px 24px 60px;}
.view.active{display:block;}

/* ── GRID ── */
.rlbl{font-size:10px;font-weight:600;color:var(--tx3);text-transform:uppercase;letter-spacing:.8px;margin-bottom:5px;}
.prow{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-bottom:16px;}
/* CARD */
.card{background:var(--sur);border:1px solid var(--bdr);border-radius:var(--r);padding:6px 5px 5px;cursor:pointer;transition:box-shadow .15s,transform .1s;min-height:104px;display:flex;flex-direction:column;box-shadow:0 1px 3px rgba(0,0,0,.06),0 2px 7px rgba(0,0,0,.04);}
.card:hover{box-shadow:0 4px 14px rgba(0,0,0,.11);transform:translateY(-1px);}
.card.s-todo{background:var(--sur);border-color:var(--bdr);}
.card.s-wip{background:var(--wip);border-color:var(--wip-b);}
.card.s-done{background:var(--done);border-color:var(--done-b);}
.card.s-val{background:var(--val);border-color:var(--val-b);}
.card.sp{border-style:dashed;opacity:.72;}
.card.couv{background:linear-gradient(135deg,#1A3A5C,#2D6A9F);border-color:#1A3A5C;}
.card.couv .cn,.card.couv .cc,.card.couv .csvc{color:rgba(255,255,255,.6);}
.card.couv .cr{color:#fff;}
.card.couv .ctype{background:rgba(255,255,255,.18);color:rgba(255,255,255,.85);}
.cn{font-size:8.5px;font-weight:600;color:var(--tx3);letter-spacing:.4px;margin-bottom:3px;}
.card.s-wip .cn{color:var(--wip-t);}
.card.s-done .cn{color:var(--done-t);}
.card.s-val .cn{color:var(--val-t);}
.cr{font-size:9.5px;font-weight:600;color:var(--ac);margin-bottom:2px;line-height:1.25;text-transform:uppercase;letter-spacing:.25px;}
.card.s-wip .cr{color:var(--wip-t);}
.card.s-done .cr{color:var(--done-t);}
.card.s-val .cr{color:var(--val-t);}
.cc{font-size:8.5px;color:var(--tx2);line-height:1.35;flex:1;overflow:hidden;}
/* content items on card */
.citem{display:flex;align-items:baseline;gap:3px;margin-bottom:1px;}
.ctype{font-size:7.5px;font-weight:600;background:var(--sur2);color:var(--tx2);border-radius:2px;padding:0 3px;white-space:nowrap;flex-shrink:0;}
.ctxt{font-size:8.5px;color:var(--tx2);line-height:1.3;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;}
.cfoot{margin-top:4px;display:flex;align-items:center;justify-content:space-between;gap:3px;flex-wrap:wrap;}
.csvc{font-size:8px;color:var(--tx3);background:rgba(0,0,0,.05);border-radius:3px;padding:1px 4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:68%;}

/* ── TABLE ── */
.twrap{overflow-x:auto;border:1px solid var(--bdr);border-radius:8px;background:var(--sur);}
table{width:100%;border-collapse:collapse;font-size:12px;}
thead th{background:var(--ac);color:#fff;padding:8px 10px;text-align:left;font-size:10px;font-weight:600;letter-spacing:.4px;text-transform:uppercase;white-space:nowrap;}
thead th:first-child{border-radius:8px 0 0 0;}
thead th:last-child{border-radius:0 8px 0 0;}
tbody tr{border-bottom:1px solid var(--bdr);transition:background .1s;}
tbody tr:hover{background:var(--sur2);}
tbody tr:last-child{border-bottom:none;}
td{padding:6px 10px;vertical-align:top;}
td.td-n{font-weight:600;color:var(--tx2);width:55px;white-space:nowrap;}
td.td-r{width:110px;}
.ti{font-family:'DM Sans',sans-serif;font-size:12px;color:var(--tx);background:transparent;border:none;width:100%;outline:none;padding:0;resize:none;min-height:18px;}
.ti:focus{background:rgba(26,90,155,.05);border-radius:3px;padding:2px 4px;}
.sbadge{display:inline-flex;align-items:center;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:600;cursor:pointer;white-space:nowrap;border:1px solid transparent;}
.sbtodo{background:var(--todo);color:var(--todo-t);border-color:var(--bdr);}
.sbwip{background:var(--wip);color:var(--wip-t);border-color:var(--wip-b);}
.sbdone{background:var(--done);color:var(--done-t);border-color:var(--done-b);}
.sbval{background:var(--val);color:var(--val-t);border-color:var(--val-b);}

/* content items in table */
.tci-list{display:flex;flex-direction:column;gap:3px;min-width:220px;}
.tci{display:flex;align-items:flex-start;gap:5px;background:var(--sur2);border-radius:4px;padding:4px 6px;}
.tci-type{font-size:10px;font-weight:600;color:var(--ac);white-space:nowrap;flex-shrink:0;}
.tci-signs{font-size:9px;color:var(--tx3);white-space:nowrap;flex-shrink:0;}
.tci-txt{font-size:11px;color:var(--tx);flex:1;}
.tci-svc{font-size:10px;color:var(--tx2);font-style:italic;}
.tci-del{background:none;border:none;color:#C04040;font-size:13px;cursor:pointer;padding:0;line-height:1;flex-shrink:0;}
.tci-del:hover{color:#8B0000;}
.add-ci-btn{font-size:11px;color:var(--ac2);background:none;border:1px dashed var(--bdr);border-radius:4px;padding:3px 7px;cursor:pointer;margin-top:2px;display:inline-block;}
.add-ci-btn:hover{background:var(--sur2);}

/* online checkbox cell */
.online-cell{display:flex;flex-direction:column;gap:4px;min-width:150px;}
.online-cell label{display:flex;align-items:center;gap:5px;font-size:11px;cursor:pointer;}
.online-cell textarea{font-size:11px;border:1px solid var(--bdr);border-radius:4px;padding:3px 5px;width:100%;resize:vertical;min-height:36px;background:var(--bg);outline:none;}
.online-cell textarea:focus{border-color:var(--ac2);}

/* services multi-select */
.svc-tags{display:flex;flex-wrap:wrap;gap:3px;min-width:130px;}
.svc-tag{font-size:10px;background:#E8F0FA;color:#1A3A5C;border-radius:3px;padding:1px 5px;display:flex;align-items:center;gap:3px;}
.svc-tag button{background:none;border:none;color:#1A3A5C;font-size:11px;cursor:pointer;padding:0;line-height:1;}
.svc-add{font-size:10px;color:var(--ac2);background:none;border:1px dashed var(--bdr);border-radius:3px;padding:1px 6px;cursor:pointer;}
.svc-add:hover{background:var(--sur2);}

/* ── STATS VIEW ── */
.stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;margin-bottom:24px;}
.stat-card{background:var(--sur);border:1px solid var(--bdr);border-radius:var(--r2);padding:16px;}
.stat-card h3{font-size:13px;font-weight:600;color:var(--ac);margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--bdr);}
.stat-row{display:flex;align-items:center;justify-content:space-between;padding:4px 0;border-bottom:1px solid var(--sur2);}
.stat-row:last-child{border-bottom:none;}
.stat-svc{font-size:12px;color:var(--tx);}
.stat-sub{font-size:11px;color:var(--tx3);margin-left:8px;}
.stat-bar-wrap{flex:1;margin:0 10px;height:6px;background:var(--sur2);border-radius:3px;overflow:hidden;}
.stat-bar{height:100%;background:var(--ac2);border-radius:3px;transition:width .4s;}
.stat-num{font-size:12px;font-weight:600;color:var(--tx);min-width:28px;text-align:right;}
.stat-total{display:flex;align-items:center;gap:8px;margin-top:12px;padding-top:8px;border-top:1px solid var(--bdr);font-size:12px;color:var(--tx2);}
.stat-badge{background:var(--ac);color:#fff;border-radius:var(--r);padding:2px 8px;font-size:11px;font-weight:600;}
/* type chart */
.type-chart{display:flex;flex-direction:column;gap:6px;}
.tc-row{display:flex;align-items:center;gap:8px;}
.tc-lbl{font-size:11px;color:var(--tx2);width:140px;flex-shrink:0;}
.tc-signs{font-size:10px;color:var(--tx3);width:70px;flex-shrink:0;text-align:right;}
.tc-bar-w{flex:1;height:8px;background:var(--sur2);border-radius:4px;overflow:hidden;}
.tc-bar{height:100%;border-radius:4px;background:var(--ac2);}
.tc-num{font-size:11px;font-weight:600;color:var(--tx);min-width:24px;text-align:right;}

/* ── MODAL SYSTEM ── */
.overlay{display:none;position:fixed;inset:0;background:rgba(20,18,14,.52);z-index:100;align-items:center;justify-content:center;padding:20px;}
.overlay.open{display:flex;}
.modal{background:var(--sur);border-radius:var(--r2);width:100%;max-width:520px;box-shadow:0 20px 56px rgba(0,0,0,.24);overflow:hidden;max-height:94vh;display:flex;flex-direction:column;}
.modal.wide{max-width:680px;}
.mhead{background:var(--ac);color:#fff;padding:12px 18px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.mttl{font-family:'DM Serif Display',serif;font-size:15px;}
.mclose{background:none;border:none;color:#fff;font-size:21px;cursor:pointer;opacity:.65;line-height:1;padding:0;}
.mclose:hover{opacity:1;}
.mbody{padding:16px 18px;display:flex;flex-direction:column;gap:12px;overflow-y:auto;}
.mfoot{padding:11px 18px;border-top:1px solid var(--bdr);display:flex;justify-content:flex-end;gap:7px;flex-shrink:0;}
.fg{display:flex;flex-direction:column;gap:4px;}
.fl{font-size:10.5px;font-weight:600;color:var(--tx2);text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:5px;}
.fi,.fsel,.fta{font-family:'DM Sans',sans-serif;font-size:13px;color:var(--tx);background:var(--bg);border:1px solid var(--bdr);border-radius:var(--r);padding:7px 9px;outline:none;transition:border-color .15s;width:100%;}
.fi:focus,.fsel:focus,.fta:focus{border-color:var(--ac2);}
.fta{resize:vertical;min-height:55px;}
.sbtns,.pbtns{display:flex;gap:5px;}
.sbtn,.pbtn{flex:1;padding:6px 3px;border:2px solid transparent;border-radius:var(--r);font-family:inherit;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;text-align:center;}
.sbtn.st{background:var(--todo);color:var(--todo-t);border-color:var(--bdr);}
.sbtn.sw{background:var(--wip);color:var(--wip-t);border-color:var(--wip-b);}
.sbtn.sd{background:var(--done);color:var(--done-t);border-color:var(--done-b);}
.sbtn.sv{background:var(--val);color:var(--val-t);border-color:var(--val-b);}
.sbtn.on,.pbtn.on{outline:3px solid var(--ac);outline-offset:1px;}
.pbtn.pa{background:#E8F0FA;color:#1A3A5C;border-color:#B8CEE8;}
.pbtn.pb{background:#F0EAF8;color:#4A1A7A;border-color:#C8B0E8;}
.bc{background:none;border:1px solid var(--bdr);border-radius:var(--r);padding:7px 14px;font-family:inherit;font-size:13px;cursor:pointer;color:var(--tx2);}
.bs{background:var(--ac);border:none;border-radius:var(--r);padding:7px 16px;font-family:inherit;font-size:13px;font-weight:600;color:#fff;cursor:pointer;transition:opacity .15s;}
.bs:hover{opacity:.85;}
.bd{background:#B02020;border:none;border-radius:var(--r);padding:7px 14px;font-family:inherit;font-size:13px;color:#fff;cursor:pointer;}
.bd:hover{opacity:.85;}

/* ── INFO BTN ── */
.ib{display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:var(--ac2);color:#fff;font-size:8px;font-weight:700;cursor:pointer;flex-shrink:0;}
.ipop{display:none;position:fixed;z-index:200;background:var(--sur);border:1px solid var(--bdr);border-radius:8px;padding:13px;max-width:340px;box-shadow:0 8px 30px rgba(0,0,0,.17);font-size:12px;line-height:1.6;color:var(--tx);}
.ipop.open{display:block;}
.ipop h4{font-size:13px;font-weight:600;margin-bottom:8px;color:var(--ac);}
.ipop ol{padding-left:15px;}
.ipop ol li{margin-bottom:6px;}

/* content items in modal */
.ci-list{display:flex;flex-direction:column;gap:6px;}
.ci-item{background:var(--sur2);border-radius:var(--r);padding:8px 10px;display:flex;flex-direction:column;gap:5px;position:relative;}
.ci-item-head{display:flex;align-items:center;gap:6px;}
.ci-type-sel{font-size:12px;background:var(--sur);border:1px solid var(--bdr);border-radius:var(--r);padding:4px 6px;color:var(--tx);outline:none;}
.ci-type-sel:focus{border-color:var(--ac2);}
.ci-signs-hint{font-size:10px;color:var(--tx3);font-style:italic;}
