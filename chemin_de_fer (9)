function esc(s){return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

function renderTable(){
  const tb=document.getElementById('tbody');tb.innerHTML='';
  pages.forEach((p,i)=>{
    const tr=document.createElement('tr');
    // page num
    const tdN=document.createElement('td');tdN.className='td-n';tdN.textContent=pgLabel(i);tr.appendChild(tdN);
    // rubrique
    const tdR=document.createElement('td');tdR.className='td-r';
    const ri=document.createElement('input');ri.className='ti';ri.value=p.r||'';ri.placeholder='Rubrique';
    ri.onchange=()=>{p.r=ri.value;scheduleAutoSave();if(document.getElementById('view-grid').classList.contains('active'))renderGrid();};
    tdR.appendChild(ri);tr.appendChild(tdR);
    // contenus
    const tdC=document.createElement('td');
    tdC.appendChild(buildCiTableCell(i,p));
    tr.appendChild(tdC);
    // services
    const tdS=document.createElement('td');
    tdS.appendChild(buildSvcsCell(i,p));
    tr.appendChild(tdS);
    // parcours
    const tdP=document.createElement('td');tdP.style.textAlign='center';
    const pp=document.createElement('span');pp.className='ppill p'+(p.p||'b').toLowerCase();pp.textContent=p.p||'B';pp.style.cssText='cursor:pointer;font-size:11px;padding:2px 8px;';
    pp.onclick=()=>{const n=p.p==='A'?'B':'A';p.p=n;pp.className='ppill p'+n.toLowerCase();pp.textContent=n;scheduleAutoSave();if(document.getElementById('view-grid').classList.contains('active'))renderGrid();};
    tdP.appendChild(pp);tr.appendChild(tdP);
    // statut
    const tdSt=document.createElement('td');
    const sb=document.createElement('span');sb.className='sbadge sb'+(p.st||'todo');sb.textContent=SLBL[p.st||'todo'];
    sb.onclick=()=>{const c=p.st||'todo',n=SCYCLE[(SCYCLE.indexOf(c)+1)%4];p.st=n;sb.className='sbadge sb'+n;sb.textContent=SLBL[n];scheduleAutoSave();updateProg();if(document.getElementById('view-grid').classList.contains('active'))renderGrid();};
    tdSt.appendChild(sb);tr.appendChild(tdSt);
    // online
    const tdO=document.createElement('td');
    tdO.appendChild(buildOnlineCell(i,p));
    tr.appendChild(tdO);
    tb.appendChild(tr);
  });
}

function buildCiTableCell(i,p){
  const wrap=document.createElement('div');wrap.className='tci-list';
  (p.ci||[]).forEach((ci,j)=>{
    const tp=TYPES.find(t=>t.id===ci.t);
    const row=document.createElement('div');row.className='tci';
    const tl=document.createElement('span');tl.className='tci-type';tl.textContent=tp?tp.lbl:'–';
    const sg=document.createElement('span');sg.className='tci-signs';sg.textContent=tp&&tp.signs?tp.signs+'sc':'';
    const tx=document.createElement('span');tx.className='tci-txt';tx.textContent=ci.tx||'';
    const dl=document.createElement('button');dl.className='tci-del';dl.textContent='✕';
    dl.onclick=()=>{p.ci.splice(j,1);scheduleAutoSave();renderTable();if(document.getElementById('view-grid').classList.contains('active'))renderGrid();};
    row.appendChild(tl);row.appendChild(sg);row.appendChild(tx);row.appendChild(dl);
    wrap.appendChild(row);
  });
  const add=document.createElement('button');add.className='add-ci-btn';add.textContent='＋ Contenu';
  add.onclick=()=>{openEdit(i);};
  wrap.appendChild(add);return wrap;
}

function buildSvcsCell(i,p){
  const wrap=document.createElement('div');wrap.className='svc-tags';
  (p.svcs||[]).forEach(s=>{
    const t=document.createElement('span');t.className='svc-tag';t.textContent=s;
    const d=document.createElement('button');d.textContent='×';
    d.onclick=()=>{p.svcs=p.svcs.filter(x=>x!==s);scheduleAutoSave();renderTable();};
    t.appendChild(d);wrap.appendChild(t);
  });
  const add=document.createElement('select');add.className='svc-add';
  const defO=document.createElement('option');defO.value='';defO.textContent='＋';add.appendChild(defO);
  ALL_SVCS.forEach(s=>{const o=document.createElement('option');o.value=s;o.textContent=s;add.appendChild(o);});
  add.onchange=()=>{if(add.value&&!(p.svcs||[]).includes(add.value)){p.svcs=p.svcs||[];p.svcs.push(add.value);scheduleAutoSave();renderTable();}add.value='';};
  wrap.appendChild(add);return wrap;
}

function buildOnlineCell(i,p){
  const wrap=document.createElement('div');wrap.className='online-cell';
  const lbl=document.createElement('label');
  const cb=document.createElement('input');cb.type='checkbox';cb.checked=!!p.on;
  cb.onchange=()=>{p.on=cb.checked;scheduleAutoSave();};
  lbl.appendChild(cb);lbl.appendChild(document.createTextNode(' En ligne + RS'));
  const ta=document.createElement('textarea');ta.placeholder='Commentaire…';ta.value=p.onc||'';
  ta.onchange=()=>{p.onc=ta.value;scheduleAutoSave();};
  wrap.appendChild(lbl);wrap.appendChild(ta);return wrap;
}

