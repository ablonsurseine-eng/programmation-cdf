let pages=[], curIdx=null, curSta='todo', curPar='B', curSvcs=[], curCi=[];
let apiUrl = localStorage.getItem(API_KEY)||'';
let autoSaveTimer=null;

// ════════════════════════════════════════════════════
// STORAGE / COLLAB
// ════════════════════════════════════════════════════
async function load(){
  if(apiUrl){
    try{
      const r=await fetch(apiUrl+'?t='+Date.now());
      if(r.ok){const d=await r.json();if(d&&d.pages){pages=d.pages;applyMeta(d);return;}}
    }catch(e){}
  }
  try{const s=localStorage.getItem(KEY);if(s){const d=JSON.parse(s);pages=d.pages||[];applyMeta(d);return;}}catch(e){}
  pages=JSON.parse(JSON.stringify(DEF_PAGES));
}

function applyMeta(d){
  if(d.retroDate) document.getElementById('retroDate').value=d.retroDate;
}

function getData(){
  return {
    pages,
    retroDate: document.getElementById('retroDate').value,
    ts: Date.now()
  };
}

async function saveData(silent=false){
  const d=getData();
  localStorage.setItem(KEY,JSON.stringify(d));
  if(apiUrl){
    try{await fetch(apiUrl,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});}catch(e){}
  }
  if(!silent){
    const n=new Date();
    document.getElementById('lastSave').textContent='Sauvegardé '+n.getHours().toString().padStart(2,'0')+':'+n.getMinutes().toString().padStart(2,'0');
  }
}

function scheduleAutoSave(){
  clearTimeout(autoSaveTimer);
  autoSaveTimer=setTimeout(()=>saveData(true),2000);
}

function manualSave(){
  saveData(false);
  const btn=document.querySelector('.btn-save-manual');
  btn.textContent='✓ Sauvegardé !';
  setTimeout(()=>btn.textContent='💾 Sauvegarder',2000);
}

function openCollabConfig(){
  document.getElementById('api-url').value=apiUrl;
  document.getElementById('collabOverlay').classList.add('open');
}

function saveCollabConfig(){
  apiUrl=document.getElementById('api-url').value.trim();
  localStorage.setItem(API_KEY,apiUrl);
  const st=document.getElementById('collab-status');
  if(apiUrl){
    st.innerHTML='<div class="minfo" style="background:#E8F5ED;">✓ URL configurée. Faites une sauvegarde manuelle pour tester la connexion.</div>';
  } else {
    st.innerHTML='<div class="minfo">Mode local uniquement.</div>';
  }
}

function showCollabHelp(){ openCollabConfig(); }

// Auto-refresh si API configurée (toutes les 30s)
setInterval(async()=>{
  if(!apiUrl) return;
  try{
    const r=await fetch(apiUrl+'?t='+Date.now());
    if(!r.ok) return;
    const d=await r.json();
    if(d&&d.ts&&d.ts>getData().ts){pages=d.pages;applyMeta(d);renderAll();document.getElementById('lastSave').textContent='Sync '+new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});}
  }catch(e){}
},30000);

function resetAll(){
  if(!confirm('Réinitialiser pour un nouveau numéro ?')) return;
  pages=JSON.parse(JSON.stringify(DEF_PAGES));
  saveData(); renderAll();
}

